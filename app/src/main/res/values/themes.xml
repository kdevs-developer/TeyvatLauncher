<resources>
    <style name="Theme.Teyvat" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Anim.Teyvat</item>
    </style>

    <!-- App <-> home transitions: the launcher always eases in (fade + settle) and out (fade + shrink),
         instead of the system's default slide. -->
    <style name="Anim.Teyvat" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/home_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/home_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/home_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/home_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/home_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/home_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/home_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/home_exit</item>
        <item name="android:taskToFrontEnterAnimation">@anim/home_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/home_exit</item>
        <item name="android:taskToBackEnterAnimation">@anim/home_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/home_exit</item>
    </style>
</resources>
