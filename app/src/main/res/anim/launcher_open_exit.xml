<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher while an app opens: pushes towards the viewer and melts away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha
        android:fromAlpha="1.0" android:toAlpha="0.0"
        android:duration="260"
        android:interpolator="@android:interpolator/accelerate_cubic" />
    <scale
        android:fromXScale="1.0" android:toXScale="1.12"
        android:fromYScale="1.0" android:toYScale="1.12"
        android:pivotX="50%" android:pivotY="70%"
        android:duration="300"
        android:interpolator="@android:interpolator/accelerate_cubic" />
</set>
